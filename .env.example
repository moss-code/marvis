# 国内模型 OpenAI 兼容接口配置（复制为 .env 并填写）
# DeepSeek 示例：
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-d89ad14578594f988a8e352c2e9a8819
MODEL=deepseek-chat

# 通义千问示例：
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL=qwen-plus

# Kimi 示例：
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# MODEL=moonshot-v1-8k

# 办公室工作区目录（文件马 MCP、报告归档、自定义 Skill，默认：文档/PonyOffice工作区）
# WORKSPACE_DIR=D:\演示\PonyOffice工作区
# 自定义 Skill 目录：{WORKSPACE_DIR}/skills/<id>/SKILL.md

# MCP stdio 子进程：GUI 启动时若找不到 node/python/npx/uvx，追加 PATH（Windows 用 ; 分隔）
# EXTRA_PATH=D:\anaconda3;D:\anaconda3\Scripts;C:\Users\你\AppData\Roaming\npm
# 或直接指定解释器绝对路径（优先于 PATH 查找）
# MCP_NODE=C:\Program Files\nodejs\node.exe
# MCP_PYTHON=D:\anaconda3\python.exe
