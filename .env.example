# OpenAI-compatible model provider.
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-me
MODEL=deepseek-chat

# Optional: override Pony Office workspace directory.
# WORKSPACE_DIR=D:\PonyOffice工作区

# Optional: Dify Workflow integration.
# DIFY_API_BASE_URL=https://api.dify.ai/v1
# DIFY_API_KEY=app-xxxxxxxxxxxxxxxx
# Optional when you want to call /workflows/{workflow_id}/run.
# DIFY_WORKFLOW_ID=
# DIFY_TIMEOUT_MS=90000

# Optional runtime helpers for local MCP servers / Skill scripts.
# EXTRA_PATH=
# MCP_NODE=
# MCP_PYTHON=
